rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the resource owner is the authenticated user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Workspaces collection
    match /workspaces/{workspaceId} {
      // Allow creation if the request sets current user as owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow read, update, and delete if the existing document belongs to the user
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Notes collection
    match /notes/{noteId} {
      // Allow create if current user is owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow read, update, delete if document belongs to the user
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. Audit logs collection
    match /auditLogs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default deny rules for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
