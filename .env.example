# Gemini AI Studio API Key (Required for AI Summaries & Voice Task Parsing)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Firebase Project Credentials
# If provided, NestNote will connect to your custom Firebase project.
# If omitted, NestNote automatically uses local IndexedDB persistence with zero setup required!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
